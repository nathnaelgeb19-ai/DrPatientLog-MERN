  margin-bottom:20px;
}

.dashboard-kpi{
  position:relative;
  overflow:hidden;
  padding:21px;
  border:1px solid var(--line);
  border-radius:18px;
  background:var(--card);
  box-shadow:var(--shadow);
  animation:dashboardIn .45s ease both;
}

.dashboard-kpi:nth-child(2){animation-delay:.05s}
.dashboard-kpi:nth-child(3){animation-delay:.1s}
.dashboard-kpi:nth-child(4){animation-delay:.15s}

.dashboard-kpi-primary{
  background:linear-gradient(145deg,#007aff,#0062cc);
  border-color:transparent;
  color:white;
}

.dashboard-kpi-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:17px;
}

.dashboard-kpi-top span{
  font-size:12px;
  font-weight:600;
  color:var(--muted);
}

.dashboard-kpi-primary .dashboard-kpi-top span{
  color:rgba(255,255,255,.8);
}

.dashboard-kpi-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  width:38px;
  height:38px;
  border-radius:12px;
  background:rgba(0,122,255,.09);
  color:var(--teal);
}

.dashboard-kpi-primary .dashboard-kpi-icon{
  background:rgba(255,255,255,.16);
  color:white;
}

.dashboard-kpi strong{
  display:block;
  font-size:23px;
  line-height:1.2;
  letter-spacing:-.02em;
  margin-bottom:7px;
}

.dashboard-kpi small{
  display:block;
  font-size:12px;
  line-height:1.4;
  color:var(--muted);
}

.dashboard-kpi-primary small{
  color:rgba(255,255,255,.78);
}

.dashboard-main-grid{
  display:grid;
  grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr);
  gap:20px;
  margin-bottom:20px;
}

.dashboard-overview-card,
.dashboard-actions-card,
.dashboard-recent-card{
  animation:dashboardIn .5s ease both;
}

.dashboard-finance{
  padding-top:6px;
}

.dashboard-finance-row{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:15px;
  margin-bottom:8px;
}

.dashboard-finance-row div{
  display:flex;
  flex-direction:column;
  gap:4px;
}

.dashboard-finance-row span{
  font-size:12px;
  color:var(--muted);
}

.dashboard-finance-row strong{
  font-size:18px;
}

.dashboard-finance-row>b{
  font-size:12px;
  color:var(--muted);
}

.dashboard-bar{
  height:10px;
  overflow:hidden;
  margin-bottom:22px;
  border-radius:999px;
  background:rgba(0,122,255,.09);
}

.dashboard-bar div{
  height:100%;
  border-radius:inherit;
  background:linear-gradient(90deg,#007aff,#5ac8fa);
  transition:width .7s ease;
}

.dashboard-bar.earnings{
  background:rgba(52,199,89,.1);
}

.dashboard-bar.earnings div{
  background:linear-gradient(90deg,#34c759,#30d158);
}

.dashboard-finance-summary{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-top:24px;
}

.dashboard-finance-summary div{
  padding:15px;
  border-radius:14px;
  background:rgba(118,118,128,.06);
}

.dashboard-finance-summary span{
  display:block;
  margin-bottom:5px;
  font-size:11px;
  color:var(--muted);
}

.dashboard-finance-summary b{
  font-size:15px;
}

.dashboard-actions{
  display:grid;
  gap:10px;
}

.dashboard-action{
  display:flex;
  align-items:center;
  gap:13px;
  padding:13px;
  border:1px solid var(--line);
  border-radius:14px;
  color:var(--ink);
  text-decoration:none;
  transition:transform .18s ease,background .18s ease,border-color .18s ease;
}

.dashboard-action:hover{
  transform:translateY(-2px);
  background:rgba(0,122,255,.035);
  border-color:rgba(0,122,255,.22);
}

.dashboard-action-icon{
  flex:0 0 auto;
  display:flex;
  align-items:center;
  justify-content:center;
  width:39px;
  height:39px;
  border-radius:12px;
  background:rgba(0,122,255,.08);
  color:var(--teal);
}

.dashboard-action b{
  display:block;
  margin-bottom:3px;
  font-size:13px;
}

.dashboard-action span{
  display:block;
  font-size:11px;
  color:var(--muted);
}

.dashboard-recent-card{
  animation-delay:.15s;
}

@keyframes dashboardIn{
  from{
    opacity:0;
    transform:translateY(10px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

@media(max-width:1050px){
  .dashboard-kpis{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .dashboard-main-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:700px){
  .dashboard-toolbar{
    align-items:stretch;
    flex-direction:column;
  }

  .dashboard-toolbar select{
    width:100%;
  }

  .dashboard-kpis{
    grid-template-columns:1fr 1fr;
    gap:12px;
  }

  .dashboard-kpi{
    padding:17px;
  }

  .dashboard-kpi strong{
    font-size:19px;
  }

  .dashboard-kpi-top{
    margin-bottom:13px;
  }

  .dashboard-kpi-icon{
    width:34px;
    height:34px;
  }

  .dashboard-finance-summary{
    grid-template-columns:1fr;
  }
}

@media(max-width:480px){
  .dashboard-kpis{
    grid-template-columns:1fr;
  }
}

/* Compact dashboard period selector */
.dashboard-toolbar{
  align-items:center;
}

.dashboard-toolbar > div:first-child{
  min-width:0;
}

.dashboard-toolbar select{
  min-width:0;
  width:auto;
  height:38px;
  padding:0 34px 0 13px;
  border:1px solid var(--line);
  border-radius:12px;
  background:var(--card);
  color:var(--ink);
  font-size:12px;
  font-weight:600;
  box-shadow:none;
  cursor:pointer;
}

.dashboard-toolbar select:hover{
  border-color:rgba(0,122,255,.25);
}

.dashboard-toolbar select:focus{
  outline:none;
  border-color:rgba(0,122,255,.45);
  box-shadow:0 0 0 3px rgba(0,122,255,.08);
}

@media(max-width:700px){
  .dashboard-toolbar{
    align-items:flex-start;
  }

  .dashboard-toolbar select{
    width:auto;
    max-width:100%;
  }
}

/* Patients page redesign */
.patients-workspace{
  display:flex;
  flex-direction:column;
  gap:16px;
}

.patients-toolbar{
  display:flex;
  align-items:flex-end;
  gap:10px;
  padding:16px;
  border:1px solid var(--line);
  border-radius:18px;
  background:var(--card);
  box-shadow:var(--shadow);
}

.patients-search{
  position:relative;
  display:flex;
  align-items:center;
  flex:1 1 360px;
  min-width:220px;
}

.patients-search svg{
  position:absolute;
  left:13px;
  color:var(--muted);
}

.patients-search input{
  width:100%;
  height:42px;
  padding:0 14px 0 40px;
  border:1px solid var(--line);
  border-radius:12px;
  background:var(--bg);
}

.patients-date{
  display:flex;
  flex-direction:column;
  gap:5px;
}

.patients-date label{
  font-size:10px;
  font-weight:700;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.06em;
}

.patients-date input{
  height:42px;
  padding:0 10px;
  border:1px solid var(--line);
  border-radius:12px;
  background:var(--bg);
}

.patients-filter-button,
.patients-clear-button,
.patients-export-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  height:42px;
  padding:0 14px;
  border-radius:12px;
  font-size:12px;
  font-weight:700;
  white-space:nowrap;
  cursor:pointer;
  text-decoration:none;
}

.patients-filter-button{
  border:0;
  background:var(--teal);
  color:white;
}

.patients-clear-button{
  border:1px solid var(--line);
  background:var(--card);
  color:var(--ink);
}

.patients-export-button{
  border:1px solid var(--line);
  background:var(--card);
  color:var(--ink);
}

.patients-filter-button:hover,
.patients-clear-button:hover,
.patients-export-button:hover{
  transform:translateY(-1px);
}

.patients-summary{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding:2px 3px;
}

.patients-summary span{
  display:block;
  margin-bottom:2px;
  font-size:11px;
  color:var(--muted);
}

.patients-summary strong{
  font-size:17px;
}

.patients-summary-note{
  font-size:11px;
  color:var(--muted);
}

.patients-table-wrap{
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:18px;
  background:var(--card);
  box-shadow:var(--shadow);
}

@media(max-width:900px){
  .patients-toolbar{
    flex-wrap:wrap;
  }

  .patients-search{
    flex-basis:100%;
  }
}

@media(max-width:600px){
  .patients-toolbar{
    align-items:stretch;
    flex-direction:column;
  }

  .patients-search{
    min-width:0;
  }

  .patients-date{
    width:100%;
  }

  .patients-date input,
  .patients-filter-button,
  .patients-clear-button,
  .patients-export-button{
    width:100%;
  }

  .patients-summary{
    align-items:flex-start;
    flex-direction:column;
    gap:4px;
  }
}

/* Patient form redesign */
.patient-form-card{
  padding:0;
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:20px;
  background:var(--card);
  box-shadow:var(--shadow);
}

.patient-form-section{
  padding:25px;
}

.patient-form-heading{
  display:flex;
  align-items:center;
  gap:13px;
  margin-bottom:22px;
}

.patient-form-number{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 auto;
  width:36px;
  height:36px;
  border-radius:11px;
  background:rgba(0,122,255,.08);
  color:var(--teal);
  font-size:11px;
  font-weight:800;
}

.patient-form-heading h2{
  margin:0 0 2px;
  font-size:17px;
}

.patient-form-heading p{
  margin:0;
  color:var(--muted);
  font-size:11px;
}

.patient-form-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}

.patient-form-grid label{
  display:flex;
  flex-direction:column;
  gap:7px;
}

.patient-form-grid label > span{
  font-size:11px;
  font-weight:700;
  color:var(--ink);
}

.patient-form-grid label > span em{
  margin-left:4px;
  font-style:normal;
  font-weight:500;
  color:var(--muted);
}

.patient-form-grid input{
  width:100%;
  min-height:44px;
  padding:0 13px;
  border:1px solid var(--line);
  border-radius:12px;
  background:var(--bg);
  color:var(--ink);
}

.patient-form-grid input:focus{
  outline:none;
  border-color:rgba(0,122,255,.45);
  box-shadow:0 0 0 3px rgba(0,122,255,.08);
}

.patient-form-wide{
  grid-column:1 / -1;
}

.patient-form-divider{
  height:1px;
  background:var(--line);
}

.patient-price-field{
  display:flex;
  gap:8px;
}

.patient-price-field input{
  flex:1;
  min-width:0;
}

.patient-suggest-button{
  flex:0 0 auto;
  padding:0 14px;
  border:1px solid rgba(0,122,255,.18);
  border-radius:12px;
  background:rgba(0,122,255,.07);
  color:var(--teal);
  font-size:11px;
  font-weight:700;
  cursor:pointer;
}

.patient-suggest-button:hover{
  background:rgba(0,122,255,.12);
}

.patient-percent-field{
  position:relative;
}

.patient-percent-field input{
  padding-right:38px;
}

.patient-percent-field b{
  position:absolute;
  top:50%;
  right:13px;
  transform:translateY(-50%);
  color:var(--muted);
  font-size:13px;
}

.patient-earnings-card{
  display:flex;
  align-items:center;
  gap:13px;
  margin:0 25px 25px;
  padding:17px 18px;
  border:1px solid rgba(52,199,89,.18);
  border-radius:15px;
  background:rgba(52,199,89,.055);
}

.patient-earnings-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 auto;
  width:40px;
  height:40px;
  border-radius:12px;
  background:rgba(52,199,89,.1);
  color:#34a853;
}

.patient-earnings-card > div:nth-child(2){
  flex:1;
  min-width:0;
}

.patient-earnings-card span{
  display:block;
  margin-bottom:3px;
  font-size:12px;
  font-weight:700;
}

.patient-earnings-card small{
  display:block;
  font-size:11px;
  color:var(--muted);
}

.patient-earnings-card strong{
  font-size:19px;
  white-space:nowrap;
}

.patient-form-error{
  margin:20px 25px 0;
  padding:12px 14px;
  border:1px solid rgba(255,59,48,.18);
  border-radius:12px;
  background:rgba(255,59,48,.06);
  color:#c62828;
  font-size:12px;
  font-weight:600;
}

.patient-form-actions{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  padding:18px 25px;
  border-top:1px solid var(--line);
  background:rgba(118,118,128,.025);
}

.patient-form-actions button{
  min-height:42px;
}

.patient-save-button{
  display:inline-flex;
  align-items:center;
  gap:8px;
}

@media(max-width:700px){
  .patient-form-section{
    padding:20px;
  }

  .patient-form-grid{
    grid-template-columns:1fr;
  }

  .patient-form-wide{
    grid-column:auto;
  }

  .patient-earnings-card{
    margin:0 20px 20px;
  }

  .patient-form-error{
    margin:18px 20px 0;
  }

  .patient-form-actions{
    padding:16px 20px;
  }
}

@media(max-width:480px){
  .patient-form-actions{
    flex-direction:column-reverse;
  }

  .patient-form-actions button{
    width:100%;
    justify-content:center;
  }

  .patient-earnings-card{
    align-items:flex-start;
  }

  .patient-earnings-card strong{
    margin-left:auto;
  }
}


/* Monthly earnings v2 */
.monthly-report-card{
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:20px;
  background:var(--card);
  box-shadow:var(--shadow);
}

.monthly-report-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  padding:22px 24px;
  border-bottom:1px solid var(--line);
}

.monthly-report-label{
  display:block;
  margin-bottom:4px;
  font-size:10px;
  font-weight:800;
  letter-spacing:.07em;
  text-transform:uppercase;
  color:var(--muted);
}

.monthly-report-header h2{
  margin:0 0 4px;
  font-size:18px;
}

.monthly-report-header p{
  margin:0;
  color:var(--muted);
  font-size:11px;
}

.monthly-telegram-button{
  display:inline-flex;
  align-items:center;
  gap:7px;
  white-space:nowrap;
}

.monthly-table-wrap{
  overflow-x:auto;
}

.monthly-table{
  width:100%;
  min-width:850px;
  border-collapse:collapse;
}

.monthly-table th{
  padding:12px 16px;
  background:rgba(118,118,128,.035);
  color:var(--muted);
  font-size:10px;
  font-weight:800;
  letter-spacing:.03em;
  text-transform:uppercase;
  text-align:left;
  white-space:nowrap;
}

.monthly-table td{
  padding:16px;
  border-top:1px solid var(--line);
  font-size:12px;
  vertical-align:middle;
}

.monthly-table tbody tr{
  transition:background .15s ease;
}

.monthly-table tbody tr:hover{
  background:rgba(0,122,255,.025);
}

.monthly-current-row{
  background:rgba(0,122,255,.025);
}

.monthly-month-cell{
  display:flex;
  align-items:center;
  gap:11px;
  min-width:180px;
}

.monthly-month-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 auto;
  width:36px;
  height:36px;
  border-radius:10px;
  background:rgba(0,122,255,.08);
  color:var(--teal);
}

.monthly-month-cell b{
  display:block;
  margin-bottom:3px;
  font-size:13px;
}

.monthly-month-cell small{
  display:block;
  color:var(--muted);
  font-size:10px;
}

.monthly-current-text{
  color:var(--teal) !important;
  font-weight:700;
}

.monthly-number{
  font-weight:700;
}

.monthly-money{
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}

.monthly-percent{
  display:inline-flex;
  min-width:54px;
  justify-content:center;
  padding:5px 8px;
  border-radius:8px;
  background:rgba(0,122,255,.07);
  color:var(--teal);
  font-size:11px;
  font-weight:700;
}

.monthly-earnings{
  font-size:13px;
  white-space:nowrap;
}

.monthly-action-cell{
  display:flex;
  align-items:center;
  min-width:155px;
}

.monthly-status-pill{
  display:inline-flex;
  align-items:center;
  gap:6px;
  white-space:nowrap;
}

.monthly-close-button{
  display:inline-flex;
  align-items:center;
  gap:6px;
  white-space:nowrap;
}

@media(max-width:700px){
  .monthly-report-header{
    align-items:flex-start;
    flex-direction:column;
    padding:19px;
  }

  .monthly-telegram-button{
    width:100%;
    justify-content:center;
  }

  .monthly-table{
    min-width:800px;
  }
}
