  box-shadow:0 0 0 4px rgba(24,166,106,.08);
}

.mini-avatar{
  width:32px;
  height:32px;
  border-radius:10px;
  transition:transform .18s ease;
}

.mini-avatar:hover{
  transform:scale(1.04);
}

/* ---------- Main content ---------- */

.content{
  padding:32px;
}

.page-head{
  margin-bottom:26px;
}

.page-head h1{
  font-size:30px;
  line-height:1.12;
  font-weight:800;
}

.page-head p{
  max-width:700px;
}

/* ---------- Buttons ---------- */

.primary,
.ghost{
  min-height:42px;
  padding:11px 16px;
  border-radius:13px;
  transition:
    transform .16s ease,
    box-shadow .16s ease,
    background .16s ease,
    border-color .16s ease;
}

.primary:hover{
  transform:translateY(-1px);
  box-shadow:0 6px 16px rgba(0,122,255,.16);
}

.ghost:hover{
  transform:translateY(-1px);
  border-color:rgba(0,122,255,.18);
  box-shadow:0 4px 12px rgba(0,0,0,.05);
}

.primary:active,
.ghost:active{
  transform:translateY(0);
}

.small{
  min-height:34px;
  padding:8px 12px;
  border-radius:10px;
}

/* ---------- Cards ---------- */

.card,
.stat,
.toolbar{
  transition:
    transform .18s ease,
    box-shadow .18s ease,
    border-color .18s ease;
}

.card:hover,
.stat:hover,
.toolbar:hover{
  box-shadow:
    0 2px 5px rgba(0,0,0,.04),
    0 14px 34px rgba(0,0,0,.07);
}

.stat{
  position:relative;
  overflow:hidden;
}

.stat::after{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:2px;
  background:rgba(0,122,255,.12);
  opacity:0;
  transition:opacity .18s ease;
}

.stat:hover::after{
  opacity:1;
}

.stat-icon{
  transition:
    transform .18s ease,
    background .18s ease;
}

.stat:hover .stat-icon{
  transform:scale(1.04);
  background:rgba(0,122,255,.15);
}

/* ---------- Tables ---------- */

.table-wrap{
  border-radius:13px;
}

table{
  border-spacing:0;
}

thead th{
  position:relative;
}

tbody tr{
  transition:
    background .14s ease;
}

tbody tr:hover{
  background:rgba(0,122,255,.025);
}

td{
  transition:background .14s ease;
}

.row-actions{
  opacity:.82;
  transition:opacity .15s ease;
}

tr:hover .row-actions{
  opacity:1;
}

.row-actions .icon{
  transition:
    transform .15s ease,
    background .15s ease,
    color .15s ease;
}

.row-actions .icon:hover{
  transform:translateY(-1px);
}

/* ---------- Inputs ---------- */

input,
select{
  min-height:42px;
  transition:
    background .16s ease,
    box-shadow .16s ease,
    transform .16s ease;
}

input:hover,
select:hover{
  background:rgba(118,118,128,.15);
}

input:focus,
select:focus{
  transform:translateY(-1px);
}

/* ---------- Search ---------- */

.searchbar{
  transition:
    background .16s ease,
    box-shadow .16s ease;
}

.searchbar:focus-within{
  background:rgba(0,122,255,.055);
  box-shadow:0 0 0 3px rgba(0,122,255,.07);
}

/* ---------- Pills ---------- */

.pill{
  min-height:28px;
  padding:6px 10px;
  transition:transform .15s ease;
}

.pill:hover{
  transform:translateY(-1px);
}

/* ---------- Empty / loading / error ---------- */

.empty{
  min-height:120px;
  display:grid;
  place-items:center;
}

.loading div{
  box-shadow:0 4px 18px rgba(0,0,0,.025);
}

.error{
  border-radius:12px;
  line-height:1.45;
}

/* ---------- Form surfaces ---------- */

.form{
  animation:appPageIn .42s ease both;
}

.form-grid{
  gap:20px;
}

.form-actions{
  align-items:center;
}

.form-actions button{
  transition:
    transform .16s ease,
    box-shadow .16s ease;
}

.form-actions button:hover{
  transform:translateY(-1px);
}

/* ---------- Earnings ---------- */

.earnings-preview{
  gap:14px;
}

.earnings-preview div{
  transition:
    transform .16s ease,
    box-shadow .16s ease;
}

.earnings-preview div:hover{
  transform:translateY(-1px);
  box-shadow:0 5px 16px rgba(0,122,255,.07);
}

/* ---------- Settings ---------- */

.setting{
  transition:
    background .16s ease,
    padding-left .16s ease;
  border-radius:12px;
}

.setting:hover{
  background:rgba(0,122,255,.025);
  padding-left:8px;
}

/* ---------- Toggle ---------- */

.toggle-row{
  transition:
    background .16s ease,
    box-shadow .16s ease;
}

.toggle-row:hover{
  background:rgba(0,122,255,.055);
}

/* ---------- Authentication ---------- */

.auth-card{
  animation:authCardIn .5s ease both;
}

@keyframes authCardIn{
  from{
    opacity:0;
    transform:translateY(12px) scale(.985);
  }
  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}

.auth-card .primary{
  transition:
    transform .16s ease,
    box-shadow .16s ease;
}

.auth-card .primary:hover{
  transform:translateY(-1px);
  box-shadow:0 8px 20px rgba(0,122,255,.14);
}

/* ---------- Mobile ---------- */

@media(max-width:700px){

  .content{
    padding:22px 14px;
  }

  .page-head{
    margin-bottom:20px;
  }

  .page-head h1{
    font-size:27px;
  }

  .top{
    height:64px;
  }

  .sidebar{
    transition:
      left .24s cubic-bezier(.22,.61,.36,1),
      box-shadow .24s ease;
  }

  .sidebar.open{
    box-shadow:20px 0 50px rgba(0,0,0,.16);
  }

  .card,
  .toolbar,
  .stat{
    box-shadow:
      0 1px 2px rgba(0,0,0,.035),
      0 8px 24px rgba(0,0,0,.055);
  }

  .primary,
  .ghost{
    min-height:44px;
  }

  input,
  select{
    min-height:44px;
  }
}

@media(prefers-reduced-motion:reduce){
  *,
  *::before,
  *::after{
    scroll-behavior:auto!important;
    transition:none!important;
    animation:none!important;
  }
}



