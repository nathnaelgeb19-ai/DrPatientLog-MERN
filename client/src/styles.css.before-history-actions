html[data-theme="light"] .stat span,
html[data-theme="light"] .toolbar span,
html[data-theme="light"] td,
html[data-theme="light"] .status{
  color:#8e8e93;
}

html[data-theme="light"] nav a,
html[data-theme="light"] .logout{
  color:#636366;
}

html[data-theme="light"] nav a:hover,
html[data-theme="light"] nav a.active{
  background:rgba(0,122,255,.12);
  color:#007aff;
}

html[data-theme="light"] input,
html[data-theme="light"] select{
  background:rgba(118,118,128,.12);
  color:#1c1c1e;
  border-color:transparent;
  color-scheme:light;
}

html[data-theme="light"] input::placeholder{
  color:#8e8e93;
}

html[data-theme="light"] input:hover,
html[data-theme="light"] select:hover{
  background:rgba(118,118,128,.15);
}

html[data-theme="light"] input:focus,
html[data-theme="light"] select:focus{
  background:#fff;
  color:#1c1c1e;
  box-shadow:0 0 0 3px rgba(0,122,255,.20);
}

html[data-theme="light"] .ghost{
  background:rgba(255,255,255,.94);
  color:#3a3a3c;
  border-color:rgba(60,60,67,.12);
}

html[data-theme="light"] .primary{
  background:#007aff;
  color:#fff;
}

html[data-theme="light"] .primary:hover{
  background:#0062cc;
}

html[data-theme="light"] th{
  background:transparent;
  color:#8e8e93;
  border-color:rgba(60,60,67,.12);
}

html[data-theme="light"] td{
  color:#636366;
  border-color:rgba(60,60,67,.08);
}

html[data-theme="light"] tbody tr:hover{
  background:rgba(0,122,255,.025);
}

html[data-theme="light"] .searchbar{
  background:rgba(118,118,128,.08);
}

html[data-theme="light"] .searchbar input{
  background:transparent;
}

html[data-theme="light"] .searchbar:focus-within{
  background:rgba(0,122,255,.055);
}

html[data-theme="light"] .pill{
  background:#f0f0f2;
  color:#636366;
}

html[data-theme="light"] .pill.success{
  background:#d1fae5;
  color:#065f46;
}

html[data-theme="light"] .setting{
  color:#007aff;
  border-color:rgba(60,60,67,.12);
}

html[data-theme="light"] .setting b{
  color:#1c1c1e;
}

html[data-theme="light"] .setting span{
  color:#8e8e93;
}

html[data-theme="light"] .toggle-row{
  background:rgba(118,118,128,.08);
  color:#1c1c1e;
}

html[data-theme="light"] .toggle-row span{
  color:#1c1c1e;
}

html[data-theme="light"] .error{
  background:#fee2e2;
  color:#991b1b;
  border-color:#fecaca;
}

html[data-theme="light"] .earnings-preview div{
  background:rgba(0,122,255,.08);
  border-color:transparent;
}

html[data-theme="light"] .earnings-preview b{
  color:#007aff;
}

html[data-theme="light"] .monthly-report-header{
  border-color:rgba(60,60,67,.12);
}

html[data-theme="light"] .monthly-table th{
  background:rgba(118,118,128,.035);
  color:#8e8e93;
}

html[data-theme="light"] .monthly-table td{
  border-color:rgba(60,60,67,.08);
  color:#636366;
}

html[data-theme="light"] .monthly-current-row{
  background:rgba(0,122,255,.025);
}

html[data-theme="light"] .monthly-month-icon{
  background:rgba(0,122,255,.08);
  color:#007aff;
}

html[data-theme="light"] .monthly-percent{
  background:rgba(0,122,255,.07);
  color:#007aff;
}

html[data-theme="light"] .theme-button{
  background:rgba(118,118,128,.08);
  color:#1c1c1e;
  border-color:rgba(60,60,67,.12);
}

html[data-theme="light"] .theme-menu{
  background:#fff;
  border-color:rgba(60,60,67,.12);
  box-shadow:
    0 10px 30px rgba(0,0,0,.12),
    0 2px 6px rgba(0,0,0,.05);
}

html[data-theme="light"] .theme-menu button{
  color:#1c1c1e;
}

html[data-theme="light"] .theme-menu button:hover{
  background:rgba(0,122,255,.08);
}

html[data-theme="light"] .theme-menu button.selected{
  background:rgba(0,122,255,.10);
  color:#007aff;
}

html[data-theme="light"] .auth{
  background:
    radial-gradient(
      ellipse 70% 45% at 50% -15%,
      rgba(0,122,255,.14),
      transparent
    ),
    #f2f2f7;
}

html[data-theme="light"] .auth-card{
  background:rgba(255,255,255,.94);
  color:#1c1c1e;
}

html[data-theme="light"] .auth-card h1{
  color:#1c1c1e;
}


/* Full-viewport theme overscroll */
html[data-theme="dark"],
html[data-theme="dark"] body,
html[data-theme="dark"] #root{
  background:#000;
  color-scheme:dark;
}

html[data-theme="light"],
html[data-theme="light"] body,
html[data-theme="light"] #root{
  background:#f2f2f7;
  color-scheme:light;
}

@media (prefers-color-scheme: dark){
  html:not([data-theme]),
  html:not([data-theme]) body,
  html:not([data-theme]) #root{
    background:#000;
    color-scheme:dark;
  }
}



