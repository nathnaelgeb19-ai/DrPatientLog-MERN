/* =========================================================
   DrPatientLog — Global UI System
   One-stage visual refinement
   Does not alter application logic.
   ========================================================= */

/* ---------- App motion ---------- */

.content{
  animation:appPageIn .48s cubic-bezier(.22,.61,.36,1) both;
  will-change:opacity,transform;
}

@keyframes appPageIn{
  0%{
    opacity:0;
    transform:translateY(14px) scale(.992);
  }
  55%{
    opacity:.92;
  }
  100%{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}

/* Shared surfaces gently follow the page entrance */
.content > *{
  animation:contentChildIn .52s cubic-bezier(.22,.61,.36,1) both;
}

.content > *:nth-child(2){
  animation-delay:.035s;
}

.content > *:nth-child(3){
  animation-delay:.07s;
}

@keyframes contentChildIn{
  from{
    opacity:0;
    transform:translateY(8px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

@media(prefers-reduced-motion:reduce){
  .content,
  .content > *{
    animation:none!important;
  }
}

/* ---------- Sidebar ---------- */

.sidebar{
  padding:20px 14px;
  transition:
    box-shadow .22s ease,
    background .22s ease;
}

.brand{
  padding:5px 9px 20px;
}

.brand b{
  font-size:16px;
  letter-spacing:-.02em;
}

.brand span{
  font-size:12px;
}

.logo{
