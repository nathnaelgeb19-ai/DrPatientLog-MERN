/* =========================================================
   Theme selector + global spacing/icon refinement
   ========================================================= */

/* ---------- Theme control ---------- */

.theme-control{
  position:relative;
}

.theme-button{
  display:inline-flex;
  align-items:center;
  gap:7px;
  min-height:36px;
  padding:0 10px;
  border:1px solid var(--line);
  border-radius:11px;
  background:rgba(118,118,128,.08);
  color:var(--ink);
  font-size:12px;
  font-weight:600;
  cursor:pointer;
  transition:
    background .16s ease,
    border-color .16s ease,
    transform .16s ease;
}

.theme-button:hover{
  background:rgba(0,122,255,.08);
  border-color:rgba(0,122,255,.18);
  transform:translateY(-1px);
}

.theme-chevron{
  font-size:13px;
  line-height:1;
  color:var(--muted);
  margin-left:1px;
}

.theme-menu{
  position:absolute;
  top:calc(100% + 8px);
  right:0;
  z-index:30;
  min-width:145px;
  padding:6px;
  display:none;
  border:1px solid var(--line);
  border-radius:14px;
  background:var(--card);
  box-shadow:
    0 10px 30px rgba(0,0,0,.12),
    0 2px 6px rgba(0,0,0,.05);
}

.theme-control:hover .theme-menu,
.theme-control:focus-within .theme-menu{
  display:grid;
  animation:themeMenuIn .16s ease both;
}

.theme-menu button{
  display:flex;
  align-items:center;
  gap:9px;
  width:100%;
  min-height:38px;
  padding:8px 9px;
  border:0;
  border-radius:9px;
  background:transparent;
  color:var(--ink);
  font-size:12px;
  font-weight:600;
  text-align:left;
  cursor:pointer;
}

.theme-menu button:hover{
  background:rgba(0,122,255,.08);
}

.theme-menu button.selected{
  background:rgba(0,122,255,.10);
  color:var(--teal);
}

.theme-menu button svg:last-child{
  margin-left:auto;
}

@keyframes themeMenuIn{
  from{
    opacity:0;
    transform:translateY(-4px) scale(.98);
  }
  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}

