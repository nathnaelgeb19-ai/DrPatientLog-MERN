function Shell({doctor,onLogout,children}){const loc=useLocation(),[open,setOpen]=useState(false);const nav=[['/','Dashboard',LayoutDashboard],['/patients','Patients',Users],['/monthly','Monthly',CalendarDays],['/audit','Audit log',ClipboardList],...(doctor.role==='admin'?[['/doctors','Doctors',UserRoundCog],['/backup','Backup',Database],['/settings','Settings',Settings]]:[])];return <div className="app"><aside className={open?'sidebar open':'sidebar'}><div className="brand"><div className="logo"><Stethoscope size={22}/></div><div><b>DrPatientLog</b><span>Clinical workspace</span></div><button className="icon mobile" onClick={()=>setOpen(false)}><X/></button></div><div className="profile"><div className="avatar">{doctor.name?.[0]}</div><div><b>{doctor.name}</b><span>{doctor.role==='admin'?'Administrator':'Doctor'}</span></div></div><nav>{nav.map(([to,label,I])=><Link key={to} to={to} className={loc.pathname===to?'active':''} onClick={()=>setOpen(false)}><I size={18}/>{label}</Link>)}</nav><button className="logout" onClick={onLogout}><LogOut size={18}/>Sign out</button></aside><main><header className="top"><button className="icon mobile" onClick={()=>setOpen(true)}><Menu/></button><div className="top-title">{loc.pathname==='/'?'Dashboard':loc.pathname.slice(1).replaceAll('-',' ')}</div><div className="top-actions"><span className="status"><span/>System ready</span><div className="mini-avatar">{doctor.name?.[0]}</div></div></header><div className="content">{children}</div></main></div>}
