function Dashboard(){const[d,setD]=useState(),[range,setRange]=useState('eth_month');useEffect(()=>{api.get('/dashboard?range='+range).then(setD)},[range]);if(!d)return <Loading/>;return <><PageHead title="Dashboard" subtitle={`${d.ethToday.month} ${d.ethToday.day}, ${d.ethToday.year}`} action={<Link className="primary" to="/patients/new"><Plus size={18}/>New patient</Link>}/><div className="toolbar"><div><b>Practice overview</b></div><select value={range} onChange={e=>setRange(e.target.value)}><option value="today">Today</option><option value="week">Last 7 days</option><option value="eth_month">Ethiopian month</option><option value="all">All time</option></select></div><div className="stats"><Stat label="Today's cut" value={money(d.todayCut)} meta="Doctor earnings" icon={ReceiptText}/><Stat label="Range cut" value={money(d.rangeCut)} meta="Selected range" icon={ArrowUpRight}/><Stat label="Range income" value={money(d.rangeIncome)} meta="Recorded income" icon={Stethoscope}/><Stat label="Patients" value={d.count} meta="Visits in range" icon={Users}/></div><section className="card"><div className="section-head"><div><h2>Recent patients</h2><p>Latest recorded visits</p></div><Link to="/patients" className="ghost">View all</Link></div><PatientTable rows={d.recent}/></section></>}
