function Audit(){const[d,setD]=useState([]);useEffect(()=>{api.get('/admin/audit').then(setD)},[]);return <><PageHead title="Audit log" subtitle="Security and activity history."/><section className="card"><div className="table-wrap"><table><thead><tr><th>Time</th><th>Doctor</th><th>Action</th><th>Entity</th><th>Detail</th></tr></thead><tbody>{d.map(x=><tr key={x._id}><td>{new Date(x.createdAt).toLocaleString()}</td><td>{x.doctorName}</td><td>{x.action}</td><td>{x.entity}</td><td>{x.detail}</td></tr>)}</tbody></table></div></section></>}
function Backup(){const download=async()=>{const b=await api.download('/admin/backup');const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='drpatientlog-backup.json';a.click();URL.revokeObjectURL(a.href)};const restore=e=>{const file=e.target.files?.[0];if(!file)return;const r=new FileReader();r.onload=async()=>{try{await api.post('/admin/restore',JSON.parse(r.result));alert('Database restored.');location.reload()}catch(x){alert(x.message)}};r.readAsText(file)};return <><PageHead title="Backup center" subtitle="Create a complete application snapshot and restore it safely."/><div className="stats"><div className="stat"><Database/><span>Local backup</span><strong>JSON snapshot</strong><small>Doctors, patients, closures, audit, settings and presets</small><button className="primary" onClick={download}><Download size={16}/>Download backup</button></div><div className="stat"><Upload/><span>Restore</span><strong>Protected action</strong><small>Use a known-good backup only.</small><label className="primary"><Upload size={16}/>Choose backup<input hidden type="file" accept="application/json" onChange={restore}/></label></div></div><section className="card"><h2>External services</h2><p>Telegram configuration is stored per doctor. Google Drive can be connected later without changing the database model.</p></section></>}
function SettingsPage(){const[f,setF]=useState({}),[tg,setTg]=useState({botToken:'',chatId:'',enabled:false}),[saved,setSaved]=useState(false);useEffect(()=>{api.get('/settings').then(setF);api.get('/auth/me').then(x=>setTg({botToken:x.doctor.telegram?.botToken||'',chatId:x.doctor.telegram?.chatId||'',enabled:!!x.doctor.telegram?.enabled}))},[]);const save=async()=>{await api.put('/settings',f);setSaved(true);setTimeout(()=>setSaved(false),1800)};const test=async()=>{try{await api.post('/admin/telegram/test',{});alert('Telegram test sent.')}catch(e){alert(e.message)}};return <><PageHead title="Settings" subtitle="Clinic branding, reporting and integrations."/><section className="card form"><h2><Palette size={19}/>Appearance & clinic</h2><div className="form-grid"><label>Clinic name<input value={f.clinic_name||''} onChange={e=>setF({...f,clinic_name:e.target.value})}/></label><label>Short name<input value={f.clinic_name_short||''} onChange={e=>setF({...f,clinic_name_short:e.target.value})}/></label><label>Language<select value={f.ui_language||'en'} onChange={e=>setF({...f,ui_language:e.target.value})}><option value="en">English</option><option value="am">Amharic</option></select></label><label>Daily report time<input type="time" value={f.telegram_daily_report_time||'19:00'} onChange={e=>setF({...f,telegram_daily_report_time:e.target.value})}/></label><label>Monthly report time<input type="time" value={f.telegram_monthly_report_time||'19:00'} onChange={e=>setF({...f,telegram_monthly_report_time:e.target.value})}/></label></div><div className="form-actions"><button className="primary" onClick={save}>Save settings</button>{saved&&<span className="pill success">Saved</span>}</div></section><section className="card form"><h2><Send size={19}/>Telegram</h2><p>Configure the current doctor's bot and chat. Tokens remain server-side.</p><div className="form-grid"><label>Bot token<input type="password" value={tg.botToken} onChange={e=>setTg({...tg,botToken:e.target.value})}/></label><label>Chat ID<input value={tg.chatId} onChange={e=>setTg({...tg,chatId:e.target.value})}/></label></div><label className="toggle-row"><input type="checkbox" checked={!!tg.enabled} onChange={e=>setTg({...tg,enabled:e.target.checked})}/><span>Enable Telegram reporting</span></label><div className="form-actions"><button className="primary" onClick={async()=>{await api.post('/doctors/'+(await api.get('/auth/me')).doctor._id+'/telegram',tg);alert('Telegram settings saved')}}>Save Telegram</button><button className="ghost" onClick={test}><Send size={16}/>Send test</button></div></section></>}
function App(){const[doctor,setDoctor]=useState(undefined),[setup,setSetup]=useState(false);useEffect(()=>{api.get('/auth/status').then(x=>{if(x.setupRequired)setSetup(true);else api.get('/auth/me').then(x=>setDoctor(x.doctor)).catch(()=>setDoctor(null))}).catch(()=>setDoctor(null))},[]);if(doctor===undefined&&!setup)return <Loading/>;if(setup)return <Setup onLogin={d=>{setSetup(false);setDoctor(d)}}/>;if(!doctor)return <Routes><Route path="/forgot" element={<Forgot/>}/><Route path="*" element={<Login onLogin={setDoctor}/>}/></Routes>;return <Shell doctor={doctor} onLogout={async()=>{await api.post('/auth/logout',{});setDoctor(null)}}><Routes><Route path="/" element={<Dashboard/>}/><Route path="/patients" element={<Patients/>}/><Route path="/patients/new" element={<PatientForm/>}/><Route path="/patients/edit/:id" element={<PatientForm/>}/><Route path="/monthly" element={<Monthly/>}/><Route path="/doctors" element={doctor.role==='admin'?<Doctors/>:<Navigate to="/"/>}/><Route path="/audit" element={<Audit/>}/><Route path="/backup" element={doctor.role==='admin'?<Backup/>:<Navigate to="/"/>}/><Route path="/settings" element={doctor.role==='admin'?<SettingsPage/>:<Navigate to="/"/>}/><Route path="*" element={<Navigate to="/"/>}/></Routes></Shell>}
