/* Flask iOS theme */
:root{
  --teal:#007aff;
  --teal2:#0062cc;
  --ink:#1c1c1e;
  --muted:#8e8e93;
  --line:rgba(60,60,67,.12);
  --card:rgba(255,255,255,.94);
  --shadow:0 1px 2px rgba(0,0,0,.04),0 10px 28px rgba(0,0,0,.06);
  font-family:"Figtree",system-ui,-apple-system,sans-serif;
}
html{background:#f2f2f7}
body{
  font-family:"Figtree",system-ui,-apple-system,sans-serif;
  background:#f2f2f7;
  color:#1c1c1e;
  -webkit-font-smoothing:antialiased;
}
.app{grid-template-columns:250px 1fr}
.sidebar{
  background:rgba(242,242,247,.88);
  backdrop-filter:saturate(180%) blur(20px);
  -webkit-backdrop-filter:saturate(180%) blur(20px);
  border-right:.5px solid rgba(60,60,67,.1);
}
.logo{
  background:linear-gradient(145deg,#5ac8fa,#007aff);
  box-shadow:0 4px 14px rgba(0,122,255,.28);
}
.avatar,.mini-avatar{
  background:linear-gradient(145deg,#5ac8fa,#007aff);
  color:#fff;
}
.profile{
  background:rgba(255,255,255,.72);
  border:0;
  box-shadow:0 1px 4px rgba(0,0,0,.04);
}
nav a:hover,nav a.active{
  background:rgba(0,122,255,.12);
  color:#007aff;
}
nav a.active{
  box-shadow:none;
}
.top{
  background:rgba(255,255,255,.82);
  backdrop-filter:saturate(180%) blur(20px);
  -webkit-backdrop-filter:saturate(180%) blur(20px);
  border-bottom:.5px solid rgba(60,60,67,.12);
}
.content{max-width:1080px}
.page-head h1{
  font-weight:800;
  letter-spacing:-.03em;
}
.eyebrow{color:#007aff!important}
.primary{
  background:#007aff;
  box-shadow:none;
  border-radius:980px;
  font-weight:600;
}
.primary:hover{background:#0062cc}
.ghost{
  background:rgba(255,255,255,.94);
  border:1px solid rgba(60,60,67,.12);
  border-radius:980px;
  font-weight:600;
}
.toolbar,.stat,.card{
  background:rgba(255,255,255,.94);
  border:0;
  box-shadow:var(--shadow);
  border-radius:16px;
}
.stat-icon{
  background:rgba(0,122,255,.12);
  color:#007aff;
}
select,input{
  background:rgba(118,118,128,.12);
  border:0;
  border-radius:12px;
}
select:focus,input:focus{
  background:#fff;
  border:0;
  box-shadow:0 0 0 3px rgba(0,122,255,.2);
}
table{font-size:.86rem}
th{
  background:transparent;
  color:#8e8e93;
  border-bottom:.5px solid rgba(60,60,67,.12);
  font-weight:600;
}
td{border-bottom:.5px solid rgba(60,60,67,.08)}
.row-actions .icon:hover{
  background:rgba(0,122,255,.08);
  color:#007aff;
}
.searchbar{
  background:rgba(118,118,128,.08);
  border:0;
}
.form-actions .primary,.form-actions .ghost{border-radius:980px}
.earnings-preview div{
  background:rgba(0,122,255,.08);
  border:0;
  border-radius:16px;
}
.pill.success{
  background:#d1fae5;
  color:#065f46;
}
.auth{
  background:radial-gradient(ellipse 70% 45% at 50% -15%,rgba(0,122,255,.14),transparent),#f2f2f7;
}
.auth-card{
  background:rgba(255,255,255,.94);
  border:0;
  border-radius:22px;
  box-shadow:0 1px 2px rgba(0,0,0,.04),0 10px 28px rgba(0,0,0,.06);
}
.error{
  background:#fee2e2;
  color:#991b1b;
  border-color:#fecaca;
}
.toggle-row{
  background:rgba(118,118,128,.08);
  border:0;
}
.toggle-row input{accent-color:#007aff}
@media(max-width:700px){
  .sidebar{
    background:rgba(242,242,247,.94);
    backdrop-filter:saturate(180%) blur(20px);
    -webkit-backdrop-filter:saturate(180%) blur(20px);
  }
  .top{
    background:rgba(255,255,255,.88);
  }
  .card,.toolbar,.stat{border-radius:16px}
}

