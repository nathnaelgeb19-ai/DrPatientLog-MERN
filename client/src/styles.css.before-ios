@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{font-family:Inter,system-ui,sans-serif;color:#13202b;background:#f4f7f8;font-synthesis:none;--teal:#087f8c;--teal2:#065f68;--ink:#13202b;--muted:#70808b;--line:#e3eaed;--card:#fff;--shadow:0 10px 35px rgba(20,45,55,.07)}*{box-sizing:border-box}body{margin:0;background:linear-gradient(145deg,#f5f9fa,#eef4f5);min-height:100vh}button,input,select{font:inherit}.app{min-height:100vh;display:grid;grid-template-columns:250px 1fr}.sidebar{background:#fff;border-right:1px solid var(--line);padding:22px 16px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh}.brand{display:flex;align-items:center;gap:11px;padding:4px 8px 22px}.brand b{display:block;font-size:15px}.brand span,.profile span{display:block;color:#8a98a0;font-size:11px;margin-top:3px}.logo{width:42px;height:42px;border-radius:13px;background:linear-gradient(145deg,#13a5b1,#08737e);color:white;display:grid;place-items:center;box-shadow:0 8px 20px #087f8c33}.logo.big{width:54px;height:54px;margin-bottom:20px}.profile{display:flex;align-items:center;gap:10px;padding:13px;border:1px solid var(--line);border-radius:14px;background:#f8fbfb;margin-bottom:20px}.avatar,.mini-avatar{width:34px;height:34px;border-radius:10px;background:#d8f0f2;color:#08737e;display:grid;place-items:center;font-weight:800}.profile b{font-size:12px}nav{display:grid;gap:5px}nav a,.logout{display:flex;align-items:center;gap:11px;padding:11px 12px;border-radius:11px;color:#63737d;text-decoration:none;font-size:13px;font-weight:600;border:0;background:none;cursor:pointer;text-align:left}nav a:hover,nav a.active{background:#e8f6f7;color:#08737e}nav a.active{box-shadow:inset 3px 0 #087f8c}.logout{margin-top:auto;color:#9a6870}.top{height:68px;background:rgba(255,255,255,.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 30px;position:sticky;top:0;z-index:4}.top-title{text-transform:capitalize;font-size:13px;font-weight:700;color:#5d6d77}.top-actions{margin-left:auto;display:flex;align-items:center;gap:16px}.status{font-size:11px;color:#73828b;display:flex;gap:6px;align-items:center}.status span{width:7px;height:7px;border-radius:50%;background:#18a66a}.mini-avatar{width:30px;height:30px;border-radius:9px;font-size:11px}.content{padding:32px;max-width:1450px;margin:auto;width:100%}.page-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}.page-head h1{margin:4px 0 7px;font-size:30px;letter-spacing:-1px}.page-head p{margin:0;color:var(--muted);font-size:13px}.eyebrow{font-size:10px!important;letter-spacing:1.6px;color:#087f8c!important;font-weight:800}.primary,.ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:11px;padding:11px 15px;border:1px solid transparent;font-weight:700;font-size:12px;text-decoration:none;cursor:pointer}.primary{background:var(--teal);color:white;box-shadow:0 7px 18px #087f8c2c}.primary:hover{background:var(--teal2)}.ghost{background:white;color:#52636d;border-color:var(--line)}.full{width:100%;margin-top:8px}.toolbar{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid var(--line);border-radius:15px;padding:15px 17px;margin-bottom:14px;box-shadow:var(--shadow)}.toolbar b{display:block;font-size:13px}.toolbar span{font-size:11px;color:var(--muted)}select,input{border:1px solid var(--line);background:#fbfdfd;border-radius:10px;padding:11px 12px;outline:none;color:var(--ink);width:100%}select:focus,input:focus{border-color:#64b7bf;box-shadow:0 0 0 3px #087f8c18}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}.stat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:var(--shadow)}.stat-icon{width:35px;height:35px;border-radius:10px;background:#e7f6f7;color:#087f8c;display:grid;place-items:center;margin-bottom:14px}.stat span{display:block;color:#73828b;font-size:11px}.stat strong{display:block;font-size:20px;margin:5px 0}.stat small{color:#9aa6ad;font-size:10px}.card{background:#fff;border:1px solid var(--line);border-radius:17px;box-shadow:var(--shadow);padding:20px}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.section-head h2{margin:0;font-size:15px}.section-head p{margin:4px 0 0;color:var(--muted);font-size:11px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:760px}th{text-align:left;color:#87959d;font-size:10px;text-transform:uppercase;letter-spacing:.7px;padding:11px 10px;border-bottom:1px solid var(--line)}td{padding:13px 10px;border-bottom:1px solid #eef2f3;font-size:12px;color:#53636d}td b{color:#1e2e38}td small{display:block;color:#9aa6ad;font-size:10px;margin-top:4px}.row-actions{display:flex;justify-content:flex-end;gap:5px}.icon{border:0;background:transparent;color:#778891;cursor:pointer;padding:7px;border-radius:8px}.icon:hover{background:#edf5f5;color:#087f8c}.icon.danger:hover{background:#fff0f1;color:#bd4551}.searchbar{display:flex;align-items:center;gap:8px;background:#f7fafb;border:1px solid var(--line);padding:6px 7px 6px 12px;border-radius:12px;margin-bottom:16px}.searchbar input{border:0;background:transparent;box-shadow:none;padding:8px}.searchbar svg{color:#91a0a8}.searchbar .ghost{padding:9px 13px;white-space:nowrap}.form{max-width:950px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}label{display:grid;gap:7px;font-size:11px;font-weight:700;color:#566772}label input,label select{margin-top:0}.split{display:flex;gap:8px;align-items:stretch}.split input{flex:1;min-width:0}.split .ghost{width:auto;white-space:nowrap}.small{padding:8px 11px;font-size:11px}.empty{text-align:center;color:var(--muted);padding:25px}.gate-link{display:block;margin-top:18px;text-align:center;color:var(--teal);font-size:11px;font-weight:600;text-decoration:none}.earnings-preview{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}.earnings-preview div{background:#f0f8f8;border:1px solid #d7eded;border-radius:12px;padding:14px}.earnings-preview span{font-size:10px;color:#71838a;display:block}.earnings-preview b{font-size:15px;display:block;margin-top:5px;color:#08737e}.form-actions{display:flex;gap:8px;margin-top:22px}.pill{display:inline-flex;align-items:center;gap:5px;border-radius:999px;background:#f0f3f4;padding:6px 9px;font-size:10px;font-weight:700}.pill.success{background:#e8f7ef;color:#23734d}.loading{padding:30vh 10%;display:grid;gap:10px}.loading div{height:70px;border-radius:16px;background:linear-gradient(90deg,#eef3f4,#fff,#eef3f4);animation:pulse 1.2s infinite}@keyframes pulse{50%{opacity:.55}}.error{background:#fff0f1;color:#a33a46;border:1px solid #f2c8cc;padding:10px;border-radius:10px;font-size:11px;margin:12px 0}.auth{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 30% 20%,#d8f1f2,transparent 35%),#f4f8f8}.auth-card{width:min(430px,100%);background:#fff;border:1px solid var(--line);box-shadow:0 25px 70px #16424a18;border-radius:22px;padding:34px}.auth-card h1{margin:0;font-size:27px;letter-spacing:-.8px}.auth-card .sub{color:var(--muted);font-size:12px;margin:8px 0 24px}.auth-card form{display:grid;gap:15px}.mobile{display:none}.setting{display:flex;gap:15px;padding:18px 0;border-bottom:1px solid var(--line);color:#087f8c}.setting div{display:grid;gap:4px}.setting b{color:#263741;font-size:13px}.setting span{color:var(--muted);font-size:11px}@media(max-width:950px){.stats{grid-template-columns:1fr 1fr}.app{grid-template-columns:220px 1fr}.content{padding:24px}.sidebar{padding:18px 12px}}@media(max-width:700px){.searchbar{display:grid;grid-template-columns:1fr}.searchbar input:first-of-type{grid-column:auto}.searchbar .ghost,.searchbar a.ghost{width:100%}.split{width:100%}.app{display:block}.sidebar{position:fixed;z-index:10;left:-280px;width:270px;transition:.2s;box-shadow:20px 0 40px #0002}.sidebar.open{left:0}.mobile{display:grid}.brand .mobile{margin-left:auto}.top{padding:0 16px}.top-actions .status{display:none}.content{padding:20px 14px}.page-head{align-items:flex-start;flex-direction:column}.stats{grid-template-columns:1fr 1fr}.form-grid,.earnings-preview{grid-template-columns:1fr}.toolbar{align-items:flex-start;gap:12px;flex-direction:column}.toolbar select{width:100%}.card{padding:15px}}



.toggle-row{display:flex;align-items:center;gap:10px;margin-top:18px;padding:12px 14px;background:#f7fafb;border:1px solid var(--line);border-radius:12px;font-size:13px;font-weight:600}.toggle-row input{width:18px;height:18px;accent-color:var(--teal);margin:0}.toggle-row span{color:var(--ink)}

