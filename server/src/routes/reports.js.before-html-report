import {Router} from 'express';import {Patient} from '../models/index.js';import {auth} from '../middleware/auth.js';import {ethiopianParts,isoToday} from '../utils/ethiopian.js';const r=Router();r.use(auth);r.get('/monthly.html',async(q,s)=>{const e=ethiopianParts(q.query.date||isoToday());const rows=await Patient.find({doctorId:q.doctor._id,ethDate:{$regex:` ${e.year}$`}}).lean();const income=rows.reduce((a,x)=>a+x.totalFee,0),cut=rows.reduce((a,x)=>a+x.myEarning,0),pct=income?rows.reduce((a,x)=>a+x.totalFee*x.doctorPct,0)/income:0;const esc=x=>String(x??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');s.set('content-type','text/html');s.send(`<!doctype html><html><head><meta charset="utf-8"><title>Monthly report</title><style>body{font-family:Arial;margin:32px;color:#17202a}table{border-collapse:collapse;width:100%}th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left}h1{margin-bottom:4px}.summary{display:flex;gap:24px;margin:20px 0}.box{padding:14px;border:1px solid #ddd;border-radius:12px}</style></head><body><h1>${esc(e.month)} ${e.year} — Monthly report</h1><p>Percentage earnings report</p><div class="summary"><div class="box">Patients <b>${rows.length}</b></div><div class="box">Income <b>${income.toFixed(2)} ETB</b></div><div class="box">Doctor % <b>${pct.toFixed(2)}%</b></div><div class="box">Doctor earnings <b>${cut.toFixed(2)} ETB</b></div></div><p><b>Calculation:</b> ${income.toFixed(2)} × ${pct.toFixed(2)}% ÷ 100 = ${cut.toFixed(2)} ETB</p><table><thead><tr><th>Eth date</th><th>Patient</th><th>Card</th><th>Procedure</th><th>Income</th><th>%</th><th>Earnings</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.ethDate)}</td><td>${esc(x.patientName)}</td><td>${esc(x.cardNumber)}</td><td>${esc(x.procedure)}</td><td>${Number(x.totalFee).toFixed(2)}</td><td>${Number(x.doctorPct).toFixed(2)}%</td><td>${Number(x.myEarning).toFixed(2)}</td></tr>`).join('')}</tbody></table></body></html>`)});export default r;
