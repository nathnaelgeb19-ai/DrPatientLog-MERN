import {Router} from 'express';
import {Doctor,Patient} from '../models/index.js';
import {sendTelegram,pendingOutbox,markOutboxSent,markOutboxFail} from '../services/telegram.js';
import {driveBackup} from '../services/googleDrive.js';
import {ethiopianParts,isoToday} from '../utils/ethiopian.js';

const r=Router();

function ok(req){
  return !process.env.CRON_SECRET||
    req.get('x-cron-secret')===process.env.CRON_SECRET||
    req.query.secret===process.env.CRON_SECRET
}

async function processOutbox(){
  const rows=await pendingOutbox(10);

  for(const row of rows){
    try{
      const doctor=await Doctor.findById(row.doctorId).lean();

      if(!doctor){
        await markOutboxFail(
          row._id,
          Number(row.attempts||0)+1,
          'Doctor not found'
        );
        continue;
      }

      const result=await sendTelegram(doctor,row.messageText);

      if(result.sent){
        await markOutboxSent(row._id);
      }else{
        await markOutboxFail(
          row._id,
          Number(row.attempts||0)+1,
          result.reason||'Telegram was not sent.'
        );
      }
    }catch(e){
      await markOutboxFail(
        row._id,
        Number(row.attempts||0)+1,
        e.message
      );
    }
  }
}

async function daily(){
  const iso=isoToday(),e=ethiopianParts(iso);

  for(const d of await Doctor.find({'telegram.enabled':true}).lean()){
    const rows=await Patient.find({
      doctorId:d._id,
      gregDate:iso
    }).lean();

    await sendTelegram(
      d,
      `DrPatientLog daily report\n${e.month} ${e.day} ${e.year}\nPatients: ${rows.length}\nIncome: ${rows.reduce((a,x)=>a+x.totalFee,0).toFixed(2)} ETB\nDoctor earnings: ${rows.reduce((a,x)=>a+x.myEarning,0).toFixed(2)} ETB`
    ).catch(()=>{});
  }

  await driveBackup().catch(()=>{});
}

r.post('/daily',async(q,s)=>{
  if(!ok(q))return s.sendStatus(403);
  await daily();
  s.json({ok:true});
});

r.post('/backup',async(q,s)=>{
  if(!ok(q))return s.sendStatus(403);
  s.json(await driveBackup());
});

export {daily,processOutbox};
export default r;
